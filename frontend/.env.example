# VITE_GROQ_API_KEY: Required for the AI Operator Copilot (Groq chat completions).
# Get a free key at https://console.groq.com/keys
# NOTE: VITE_ vars are exposed in the client bundle — use a restricted key.
VITE_GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE: Backend base URL for a SPLIT deploy (frontend on Vercel,
# backend on Render/Cloud Run). Leave empty for the combined deploy where the
# FastAPI backend serves this build same-origin. Use the https URL (no trailing
# slash); the WebSocket URL is derived from it automatically.
# Example: VITE_API_BASE="https://roadsafety-sim.onrender.com"
VITE_API_BASE=""
